# .env.example - template for your .env file, which holds your secrets and settings.
#
# How to use: copy this file to .env (same folder) and fill in the values.
# docker-compose.yml loads .env into the api container as environment variables, and
# app/config.py reads them into a Settings object. .env is in .gitignore, so your keys never
# reach git. Never put real keys in this file: it is committed.

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_TURN=claude-haiku-5-5
MODEL_REASONING=claude-sonnet-5-5

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-prep-voice-agent
# EU workspace? Uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Speech (Phase 2) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional: other models / voice (defaults in app/config.py)
# STT_MODEL=nova-3
# TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Keep each recorded answer in evals/audio/ (to replay later without speaking):
# SAVE_AUDIO=true

# --- Embeddings (Phase 3) ---
VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-4
# RETRIEVAL_K=3

# --- Accounts (Phase 4.6, 4.7) ---
# Signs the stored login codes (HMAC). Set it to a long random value, made once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it secret. Without it, a random one is made at each start (codes then stop working
# after a restart).
SECRET_KEY=
# How long a login lasts, and whether the login cookie is sent over HTTPS only.
# Keep COOKIE_SECURE=false on http://localhost; set it to true behind HTTPS (AWS).
# LOGIN_DAYS=30
# COOKIE_SECURE=false
# Login codes: minutes valid, and wrong tries before a code stops working.
# CODE_MINUTES=10
# CODE_MAX_TRIES=5
# Limits in a window of LOGIN_WINDOW_MINUTES: codes sent per email and per IP, wrong codes per
# email and per IP.
# LOGIN_WINDOW_MINUTES=15
# CODES_PER_EMAIL=3
# CODES_PER_IP=10
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=20
# Email: "console" prints each email (and its code) in `docker compose logs api` instead of
# sending it. Amazon SES comes with Phase 5.
# MAIL_PROVIDER=console
# MAIL_FROM=Interview Practice <no-reply@localhost>

# --- Cost control (Phase 4.5) ---
# Budgets in US dollars, all users together. At 80% the admin sees a warning; at 100% no new
# interview can start (a running one finishes). Prices are in pricing.yaml.
# BUDGET_MONTHLY_USD=10
# BUDGET_DAILY_USD=1.5
# BUDGET_CLAUDE_USD=4.5
# BUDGET_ELEVENLABS_USD=4
# BUDGET_DEEPGRAM_USD=1
# BUDGET_VOYAGE_USD=0.5
# Limits per user, session and input:
# INTERVIEWS_PER_DAY=4
# BRIEF_REVISIONS_MAX=3
# MAX_QUESTIONS=8
# MAX_RECORDING_SECONDS=180
# MAX_SPOKEN_CHARS=600
# MAX_DOCUMENTS_PER_INTERVIEW=10
# MAX_DOCUMENT_CHARS_PER_INTERVIEW=200000
# MAX_WEB_PAGES_PER_INTERVIEW=3
# MAX_CV_CHARS=50000

# Database: set in docker-compose.yml (local only). From the host it's
# postgresql://app:app@localhost:5433/interview
