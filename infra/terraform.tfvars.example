# terraform.tfvars.example - template for terraform.tfvars, your own values for infra/ (copy it, then edit).
#
# terraform.tfvars is git-ignored: it holds your email. Terraform reads it by itself on every
# plan / apply. Every other input has a default in main.tf.

alert_email = "you@example.com" # the AWS Budget's alerts

# The domain (default practissinterview.com, infra/domain.tf); registered in Route 53 first:
# domain = "practissinterview.com"
